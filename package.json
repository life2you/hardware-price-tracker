{
  "name": "hardware-price-tracker",
  "version": "1.0.0",
  "description": "Automated hardware price tracker for JD, Taobao, and Goofish via Playwright and GitHub Actions",
  "main": "src/index.js",
  "scripts": {
    "start": "python3 run_tracker.py",
    "crawl:cpu": "python3 run_tracker.py --category CPU --push",
    "crawl:gpu": "python3 run_tracker.py --category GPU --push",
    "login": "python3 scripts/login_helper.py all",
    "login:jd": "python3 scripts/login_helper.py jd",
    "login:tb": "python3 scripts/login_helper.py taobao",
    "login:xy": "python3 scripts/login_helper.py xianyu",
    "push": "python3 sync_to_cloud.py",
    "sync": "python3 sync_to_cloud.py"
  },
  "keywords": [
    "hardware",
    "price-tracker",
    "playwright",
    "jd",
    "taobao",
    "goofish"
  ],
  "author": "life2you",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.50.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
